# 服务器监听端口
PORT=3000
# 监听地址（0.0.0.0 允许局域网/公网访问）
HOST=0.0.0.0
# 生成二维码/邀请链接时使用的对外地址（部署后填你的域名，如 https://poker.example.com）
PUBLIC_URL=http://localhost:3000
# 对局记录 JSONL 落盘目录（每房间一个 <roomCode>.jsonl），默认 ./data/history
# HISTORY_DIR=/app/data/history

# ---------- AI 玩家（房主放置的 AI 对手，使用 Anthropic Messages API）----------
# 用 AI_* 前缀，避免与 Claude Code 自身的 ANTHROPIC_* 环境变量冲突
# 未配置 key 时，AI 会退化为「能过牌就过牌，否则弃牌」的兜底策略
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_BASE_URL=https://api.anthropic.com
# 单次决策请求超时（毫秒），默认 20000
# AI_TIMEOUT_MS=20000
# AI 行动前的随机延迟区间（毫秒），默认 800~1500
# AI_TURN_DELAY_MIN_MS=800
# AI_TURN_DELAY_MAX_MS=1500
# 诈唬注入概率（0~1，默认 0.15）：AI 选择「过牌」且对手少时可下注时，转成主动下注诈唬
# AI_BLUFF_RATE=0.15
# 诈唬下注规模占底池比例（0~1，默认 0.6 = 六成池）
# AI_BLUFF_POT_PCT=0.6
